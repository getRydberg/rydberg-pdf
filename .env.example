# Hostname this module is routed to. Must match the hostname you point at
# rydberg-frontend-pdf in your Cloudflare Tunnel (or other reverse proxy)
# config, and it is also added to Vite's allowed-hosts list at container
# start — Vite 6 rejects requests with unrecognized Host headers.
PDF_HOST=pdf.rydberg.app

# Nothing else. This module has no backend, no database, and no API keys:
# every PDF is opened, edited, and saved inside your browser, so there is
# no server-side state to configure.
